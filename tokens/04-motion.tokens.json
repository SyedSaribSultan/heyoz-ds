{
  "$description": "Durations and easing curves. easing/entrance is the cubic-bezier already hardcoded in the shipped .fade-in-spring and .cycling-text-char animations, so adopting these tokens changes no existing motion.",
  "duration": {
    "instant": {
      "$type": "string",
      "$value": "0ms",
      "$extensions": {
        "com.figma.codeSyntax": {
          "WEB": "var(--oz-duration-instant)"
        }
      }
    },
    "fast": {
      "$type": "string",
      "$value": "150ms",
      "$extensions": {
        "com.figma.codeSyntax": {
          "WEB": "var(--oz-duration-fast)"
        }
      }
    },
    "base": {
      "$type": "string",
      "$value": "250ms",
      "$extensions": {
        "com.figma.codeSyntax": {
          "WEB": "var(--oz-duration-base)"
        }
      }
    },
    "slow": {
      "$type": "string",
      "$value": "420ms",
      "$extensions": {
        "com.figma.codeSyntax": {
          "WEB": "var(--oz-duration-slow)"
        }
      }
    },
    "slower": {
      "$type": "string",
      "$value": "720ms",
      "$extensions": {
        "com.figma.codeSyntax": {
          "WEB": "var(--oz-duration-slower)"
        }
      }
    },
    "ambient": {
      "$type": "string",
      "$value": "1500ms",
      "$extensions": {
        "com.figma.codeSyntax": {
          "WEB": "var(--oz-duration-ambient)"
        }
      }
    }
  },
  "easing": {
    "entrance": {
      "$type": "string",
      "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "$extensions": {
        "com.figma.codeSyntax": {
          "WEB": "var(--oz-ease-entrance)"
        }
      }
    },
    "exit": {
      "$type": "string",
      "$value": "cubic-bezier(0.4, 0, 1, 1)",
      "$extensions": {
        "com.figma.codeSyntax": {
          "WEB": "var(--oz-ease-exit)"
        }
      }
    },
    "standard": {
      "$type": "string",
      "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
      "$extensions": {
        "com.figma.codeSyntax": {
          "WEB": "var(--oz-ease-standard)"
        }
      }
    },
    "linear": {
      "$type": "string",
      "$value": "linear",
      "$extensions": {
        "com.figma.codeSyntax": {
          "WEB": "var(--oz-ease-linear)"
        }
      }
    }
  },
  "$extensions": {
    "com.figma.modeName": "Value"
  }
}
